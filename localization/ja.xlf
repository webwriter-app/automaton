      </trans-unit>
      <trans-unit id="h6c2fe3d409d7ba36">
        <source>No valid path found. The automaton <x id="0" equiv-text="&lt;sl-badge variant=&quot;danger&quot;&gt;"/>rejects<x id="1" equiv-text="&lt;/sl-badge&gt;"/> the word <x id="2" equiv-text="&lt;b&gt;${this._automaton.simulator.word}&lt;/b&gt;"/>.</source>
        <target>有効なパスが見つかりません。オートマトンは 
          <x id="0" equiv-text="&lt;sl-badge variant=&quot;danger&quot;&gt;"/>は
          <x id="1" equiv-text="&lt;/sl-badge&gt;"/> 単語 
          <x id="2" equiv-text="&lt;b&gt;${this._automaton.simulator.word}&lt;/b&gt;"/>.
        </target>
      </trans-unit>
      <trans-unit id="h25e62c96f8182fcc">
        <source><x id="0" equiv-text="&lt;span&gt;"/>The automaton <x id="1" equiv-text="&lt;sl-badge variant=&quot;success&quot;&gt;"/>accepts<x id="2" equiv-text="&lt;/sl-badge&gt;"/> the word <x id="3" equiv-text="&lt;b&gt;${this._automaton.simulator.word || &quot;ε&quot;}&lt;/b&gt;"/>.<x id="4" equiv-text="&lt;/span&gt;"/></source>
        <target>
          <x id="0" equiv-text="&lt;span&gt;"/>オートマトンは 
          <x id="1" equiv-text="&lt;sl-badge variant=&quot;success&quot;&gt;"/>は
          <x id="2" equiv-text="&lt;/sl-badge&gt;"/> 単語 
          <x id="3" equiv-text="&lt;b&gt;${this._automaton.simulator.word || &quot;ε&quot;}&lt;/b&gt;"/>.
          <x id="4" equiv-text="&lt;/span&gt;"/>
        </target>
      </trans-unit>
      <trans-unit id="h28031e78bb7297a9">
        <source><x id="0" equiv-text="&lt;span&gt;"/>The automaton <x id="1" equiv-text="&lt;sl-badge variant=&quot;danger&quot;&gt;"/>rejects<x id="2" equiv-text="&lt;/sl-badge&gt;"/> the word <x id="3" equiv-text="&lt;b&gt;${this._automaton.simulator.word || &quot;ε&quot;}&lt;/b&gt;"/>.<x id="4" equiv-text="&lt;/span&gt;"/></source>
        <target>
          <x id="0" equiv-text="&lt;span&gt;"/>オートマトンは 
          <x id="1" equiv-text="&lt;sl-badge variant=&quot;danger&quot;&gt;"/>拒絶する
          <x id="2" equiv-text="&lt;/sl-badge&gt;"/> という言葉は 
          <x id="3" equiv-text="&lt;b&gt;${this._automaton.simulator.word || &quot;ε&quot;}&lt;/b&gt;"/>.
          <x id="4" equiv-text="&lt;/span&gt;"/>
